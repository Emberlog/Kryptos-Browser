<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Report a Bug"
        android:textColor="@color/kryptos_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Describe the issue you are facing. Device details will be sent automatically."
        android:textColor="@color/kryptos_text_secondary"
        android:textSize="12sp" />

    <EditText
        android:id="@+id/et_bug_description"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        android:background="@color/kryptos_surface"
        android:gravity="top|start"
        android:hint="What went wrong?"
        android:inputType="textMultiLine"
        android:padding="12dp"
        android:textColor="@color/kryptos_text_primary"
        android:textColorHint="@color/kryptos_text_secondary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_bug_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:text="Cancel"
            android:textColor="@color/kryptos_text_secondary" />

        <TextView
            android:id="@+id/btn_bug_submit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:padding="12dp"
            android:text="Submit Report"
            android:textColor="@color/kryptos_primary"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
