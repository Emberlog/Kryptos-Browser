<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="12dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pm_domain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/kryptos_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="example.com" />

        <TextView
            android:id="@+id/pm_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/kryptos_text_secondary"
            android:textSize="14sp"
            android:layout_marginTop="4dp"
            android:text="user@example.com" />
    </LinearLayout>

    <!-- Delete Icon -->
    <ImageView
        android:id="@+id/btn_delete_password"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="6dp"
        android:src="@android:drawable/ic_menu_delete"
        app:tint="@color/kryptos_error"
        android:background="?attr/selectableItemBackgroundBorderless" />

</LinearLayout>
