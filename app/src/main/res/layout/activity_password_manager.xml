<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/kryptos_background">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/pm_top_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btn_back_pm"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_back"
            app:tint="@color/kryptos_text_primary"
            android:layout_marginEnd="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Saved Passwords"
            android:textColor="@color/kryptos_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Empty State -->
    <TextView
        android:id="@+id/txt_empty_passwords"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/pm_top_bar"
        android:text="No saved passwords yet.\nLog in to a website to save one."
        android:textColor="@color/kryptos_text_secondary"
        android:textSize="16sp"
        android:gravity="center"
        android:visibility="gone" />

    <!-- Passwords List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/passwords_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/pm_top_bar"
        android:padding="12dp" />

</RelativeLayout>
